{
  "name": "nutrition-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "AI destekli beslenme takip uygulaması — web (Next.js) + mobil (Expo) monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "web": "npm run dev --workspace @nutrition/web",
    "mobile": "npm run start --workspace @nutrition/mobile",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2"
}

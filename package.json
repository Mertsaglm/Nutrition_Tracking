{
  "name": "nutrition-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "AI destekli beslenme takip uygulaması — web (Next.js) + mobil (Expo) monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "web": "npm run dev --workspace @nutrition/web",
    "mobile": "npm run start --workspace @nutrition/mobile",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2"
}
